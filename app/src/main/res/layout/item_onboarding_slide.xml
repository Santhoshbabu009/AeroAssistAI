<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Central Glowing Circle Graphic -->
    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/glass_card_cyan"
        android:layout_marginBottom="48dp"
        android:padding="32dp">

        <ImageView
            android:id="@+id/slideIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_plane"
            app:tint="#00E5FF"
            android:layout_gravity="center"/>
    </FrameLayout>

    <!-- Slide Title -->
    <TextView
        android:id="@+id/slideTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Flight Companion"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"/>

    <!-- Slide Description -->
    <TextView
        android:id="@+id/slideDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Real-time flight tracking, smart gate alerts, and passenger assistant right in your pocket."
        android:textColor="#8E9AA8"
        android:textSize="15sp"
        android:textAlignment="center"
        android:lineSpacingMultiplier="1.2"
        android:paddingHorizontal="16dp"/>

</LinearLayout>
