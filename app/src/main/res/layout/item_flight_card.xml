<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TOP ROW: Status Badge + Time -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/cardStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="On Time"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1BAF6E"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/status_badge_bg"/>

            <LinearLayout
                android:layout_alignParentEnd="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/cardScheduledTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:35  09, May."
                    android:textSize="13sp"
                    android:textColor="#0F1923"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/cardEstimatedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scheduled"
                    android:textSize="11sp"
                    android:textColor="#8A9BB0"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- MIDDLE ROW: Airline Logo + Flight Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Airline Logo Box -->
            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="72dp"
                android:layout_marginEnd="14dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="#003580"
                app:cardElevation="0dp">
                <TextView
                    android:id="@+id/cardAirlineLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="6E"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </androidx.cardview.widget.CardView>

            <!-- Flight Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cardFlightCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6E6653"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#0F1923"/>

                <TextView
                    android:id="@+id/cardAirlineName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IndiGo"
                    android:textSize="13sp"
                    android:textColor="#5A6A7A"
                    android:layout_marginBottom="8dp"/>

                <!-- Route: Plane Icon -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:text="✈"
                        android:textColor="#1D9B89"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- From → To -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/cardFromCity"
                            android:text="Bengaluru"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0F1923"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:id="@+id/cardFromCode"
                            android:text="(BLR)"
                            android:textSize="11sp"
                            android:textColor="#8A9BB0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <TextView
                        android:text=" → "
                        android:textColor="#8A9BB0"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/cardToCity"
                            android:text="Goa"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0F1923"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:id="@+id/cardToCode"
                            android:text="(GOI)"
                            android:textSize="11sp"
                            android:textColor="#8A9BB0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8EEF4"
            android:layout_marginVertical="12dp"/>

        <!-- BOTTOM ROW: Gate / Terminal / Belt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:text="Gate" android:textSize="11sp" android:textColor="#8A9BB0" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/cardGate" android:text="33" android:textSize="16sp" android:textStyle="bold" android:textColor="#0F1923" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:text="Terminal" android:textSize="11sp" android:textColor="#8A9BB0" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/cardTerminal" android:text="T1" android:textSize="16sp" android:textStyle="bold" android:textColor="#1D9B89" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:text="Belt" android:textSize="11sp" android:textColor="#8A9BB0" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/cardBelt" android:text="-" android:textSize="16sp" android:textStyle="bold" android:textColor="#0F1923" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
