<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF"
                android:padding="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Achievement Unlocked"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </RelativeLayout>

        <!-- Modern Certificate Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/certificateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/cert_bg_full"
            android:padding="32dp"
            android:elevation="10dp">

            <!-- Logo Section -->
            <ImageView
                android:id="@+id/certLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/cert_logo_img"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/certTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CERTIFICATE"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                app:layout_constraintTop_toBottomOf="@id/certLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/certSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OF EXCELLENCE"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.4"
                app:layout_constraintTop_toBottomOf="@id/certTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:id="@+id/dividerTop"
                android:layout_width="100dp"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/app_bg"
                app:layout_constraintTop_toBottomOf="@id/certSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/certPresentedTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="This is to certify that"
                android:textColor="#A0A0A0"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/dividerTop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="SANTHOSH BABU"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/certPresentedTo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/certDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Has successfully demonstrated exceptional knowledge in Airport Operations and Aviation Safety."
                android:textColor="#D0D0D0"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/userName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/metricsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/certDescription">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:text="DATE" android:textColor="#00E5FF" android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/certificateDate" android:text="12 MAY 2026" android:textColor="#FFFFFF" android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:text="ID" android:textColor="#00E5FF" android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/certificateId" android:text="AAAI-8821" android:textColor="#FFFFFF" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/certSignature"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/cert_signature_img"
                app:layout_constraintTop_toBottomOf="@id/metricsRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Founder, AeroAssist AI"
                android:textColor="#A0A0A0"
                android:textSize="9sp"
                app:layout_constraintTop_toBottomOf="@id/certSignature"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnSendEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#00E5FF"
            android:text="Claim &amp; Email Certificate"
            android:textColor="#060E1F"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnDownload"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#1A1A1A"
            android:text="Share with Friends"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:strokeColor="#00E5FF"
            app:strokeWidth="1dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text=""
            android:textColor="#00E5FF"
            android:textSize="14sp"/>

    </LinearLayout>
</ScrollView>
