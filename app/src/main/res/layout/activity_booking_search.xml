<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/login_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="Book Flights"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
        
    <TextView
        android:text="Search authentic live airline tickets globally."
        android:textSize="14sp"
        android:textColor="#E0E0E0"
        android:layout_marginBottom="30dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#CCFFFFFF">

        <LinearLayout
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Origin Airport"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#444444"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <EditText
                android:id="@+id/originInput"
                android:hint="e.g. DEL, JFK, LHR"
                android:textSize="18sp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:maxLength="3"/>

            <TextView
                android:text="Destination Airport"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="15dp"
                android:textColor="#444444"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>       
            <EditText
                android:id="@+id/destInput"
                android:hint="e.g. BOM, LAX, CDG"
                android:textSize="18sp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:maxLength="3"/>

            <TextView
                android:text="Departure Date"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="15dp"
                android:textColor="#444444"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/> 
            <Button
                android:id="@+id/dateBtn"
                android:text="Select Date"
                android:layout_marginTop="5dp"
                android:backgroundTint="#81B4F1"
                android:textColor="#FFFFFF"
                android:layout_width="match_parent"
                android:layout_height="50dp"/>

            <Button
                android:id="@+id/searchBtn"
                android:text="Search Live Flights"
                android:layout_marginTop="30dp"
                android:backgroundTint="#6C4AB6"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="55dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
