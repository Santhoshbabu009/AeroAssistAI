<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/login_bg" />

    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <LinearLayout
        android:id="@+id/logoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AeroAssist AI"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold|italic" />

        <View
            android:layout_width="160dp"
            android:layout_height="1dp"
            android:background="#4DFFFFFF"
            android:layout_marginVertical="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADMIN PORTAL"
            android:textColor="#FFA726"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/logoContainer"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card_bg"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Vendor Account"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Admin Key -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Secret Key"
                android:textColor="#FFA726"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/adminKeyInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/edit_text_outline_bg"
                android:hint="Required for verification"
                android:textColorHint="#80FFFFFF"
                android:textColor="@color/white"
                android:paddingHorizontal="16dp"
                android:inputType="textPassword"
                android:layout_marginBottom="12dp" />

            <!-- Vendor Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vendor Business Name"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/vendorNameInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/edit_text_outline_bg"
                android:hint="e.g. KFC Express"
                android:textColorHint="#80FFFFFF"
                android:textColor="@color/white"
                android:paddingHorizontal="16dp"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <!-- Vendor Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vendor Email Address"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/vendorEmailInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/edit_text_outline_bg"
                android:hint="kfc@airport.com"
                android:textColorHint="#80FFFFFF"
                android:textColor="@color/white"
                android:paddingHorizontal="16dp"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="12dp" />

            <!-- Vendor Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vendor Password"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/vendorPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/edit_text_outline_bg"
                android:hint="Minimum 6 characters"
                android:textColorHint="#80FFFFFF"
                android:textColor="@color/white"
                android:paddingHorizontal="16dp"
                android:inputType="textPassword"
                android:layout_marginBottom="12dp" />

            <!-- Vendor Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vendor Type"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/vendorTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/edit_text_outline_bg"
                android:backgroundTint="#80FFFFFF"
                android:padding="6dp"
                android:layout_marginBottom="12dp" />

            <!-- Location Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terminal"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/terminalSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/edit_text_outline_bg"
                        android:backgroundTint="#80FFFFFF"
                        android:padding="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gate Number"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/gateInput"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/edit_text_outline_bg"
                        android:hint="Gate 14"
                        android:textColorHint="#80FFFFFF"
                        android:textColor="@color/white"
                        android:paddingHorizontal="16dp"
                        android:inputType="text" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/registerButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="REGISTER VENDOR"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/login_btn_bg"
                android:textColor="@color/white" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4DFFFFFF"
                android:layout_marginVertical="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remove Vendor Account"
                android:textColor="#FF8A80"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Vendor Email to Delete -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vendor Email to Remove"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/deleteEmailInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/edit_text_outline_bg"
                android:hint="e.g. kfc@airport.com"
                android:textColorHint="#80FFFFFF"
                android:textColor="@color/white"
                android:paddingHorizontal="16dp"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/deleteButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="REMOVE VENDOR ACCOUNT"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/login_btn_bg"
                android:backgroundTint="#D32F2F"
                android:textColor="@color/white" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
