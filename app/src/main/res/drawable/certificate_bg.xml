<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base White Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <stroke android:width="2dp" android:color="#D4AF37"/>
        </shape>
    </item>
    
    <!-- Top Left Accent -->
    <item android:top="-50dp" android:left="-50dp" android:width="150dp" android:height="150dp">
        <rotate android:fromDegrees="45">
            <shape android:shape="rectangle">
                <solid android:color="#1A237E"/>
            </shape>
        </rotate>
    </item>
    
    <!-- Bottom Right Accent -->
    <item android:bottom="-50dp" android:right="-50dp" android:width="150dp" android:height="150dp">
        <rotate android:fromDegrees="45">
            <shape android:shape="rectangle">
                <solid android:color="#1A237E"/>
            </shape>
        </rotate>
    </item>

    <!-- Inner Border -->
    <item android:top="10dp" android:left="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#D4AF37"/>
        </shape>
    </item>
</layer-list>
