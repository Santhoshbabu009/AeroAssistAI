<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <application
        android:name=".AeroAssistApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="AeroAssistAI"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AeroAssistAI">

        <!-- Launcher Activity -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".UserTypeSelectionActivity" android:exported="true"/>
        <activity android:name=".AuthActivity" android:exported="true"/>

        <!-- Authentication -->
        <activity android:name=".OtpActivity" android:exported="false"/>
        <activity android:name=".SignUpActivity" android:exported="false"/>

        <!-- App Screens -->
        <activity android:name=".MainActivity" android:exported="false"/>
        <activity android:name=".FlightStatusActivity" android:exported="false"/>
        <activity android:name=".ChatbotActivity" android:exported="false" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden"/>
        <activity android:name=".NavigationActivity" android:exported="false"/>
        <activity android:name=".PasswordResetOtpActivity" />
        <activity android:name=".NewPasswordActivity" />
        <activity android:name=".ProfileActivity" />
