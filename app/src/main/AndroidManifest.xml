        <activity android:name=".StoreMenuActivity" android:exported="false"/>
        <activity android:name=".CurrencyConverterActivity" android:exported="false"/>
        <activity android:name=".TimeZoneActivity" android:exported="false"/>
        <activity android:name=".UnitConverterActivity" android:exported="false"/>
        <activity android:name=".AirportGuideActivity" android:exported="false"/>
        <activity android:name=".SecurityGuideActivity" android:exported="false"/>
        <activity android:name=".CustomsGuideActivity" android:exported="false"/>
        <activity android:name=".VisaInfoActivity" android:exported="false"/>
        <activity android:name=".BaggageHubActivity" android:exported="false"/>
